{
  "name": "codex-desktop-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.18.0"
  },
  "scripts": {
    "dev": "pnpm tools:bootstrap && pwsh -File scripts\\dev-check.ps1",
    "dev:server": "vite",
    "dev:check": "pwsh -File scripts\\dev-check.ps1 -CheckOnly",
    "dev:launch": "pwsh -File scripts\\dev-start.ps1",
    "lint": "biome check src vite.config.ts vitest.config.ts",
    "lint:fix": "biome check --write src vite.config.ts vitest.config.ts",
    "test:frontend": "vitest run",
    "tools:bootstrap": "pwsh -NoProfile -File scripts\\bootstrap-tools.ps1",
    "tools:check": "pwsh -NoProfile -File scripts\\bootstrap-tools.ps1 -CheckOnly",
    "rg": "pwsh -NoProfile -File scripts\\run-ripgrep.ps1",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "build:desktop": "pnpm tools:bootstrap && pnpm build",
    "release:check": "pwsh -File scripts\\release-check.ps1 -CheckOnly",
    "release:build": "pwsh -File scripts\\release-check.ps1 -SkipLaunch",
    "release": "pwsh -File scripts\\release-check.ps1",
    "check": "pnpm build:desktop && cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "clippy": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test": "cargo test --locked --manifest-path src-tauri/Cargo.toml --all-targets",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "verify:benchmarks": "pnpm measure:streaming && pnpm measure:soak && pnpm measure:diff",
    "verify:frontend": "pnpm lint && pnpm test:frontend && pnpm verify:benchmarks && pnpm verify:visual && pnpm build",
    "verify:visual": "node scripts/verify-visual-preview.mjs",
    "verify:native": "pnpm tools:bootstrap && pnpm verify:transitive && cargo check --locked --manifest-path src-tauri/Cargo.toml && pnpm format:check && pnpm clippy && pnpm test",
    "verify": "pnpm verify:frontend && pnpm verify:native",
    "verify:transitive": "node scripts/verify-transitive-dependencies.mjs",
    "verify:version": "node scripts/verify-version.mjs",
    "measure:release": "pwsh -File scripts/measure-release.ps1",
    "measure:diff": "node --experimental-strip-types scripts/measure-diff.ts",
    "measure:history": "node --import ./scripts/register-typescript-imports.mjs --expose-gc --max-old-space-size=4096 --experimental-strip-types scripts/measure-history.ts",
    "measure:search": "cargo test --release --locked --manifest-path src-tauri/Cargo.toml engine::native::tools::fs::tests::benchmark_ripgrep_against_previous_scanner -- --ignored --nocapture --test-threads=1",
    "measure:soak": "node --experimental-strip-types scripts/measure-soak.ts",
    "measure:streaming": "node --experimental-strip-types scripts/measure-streaming.ts",
    "measure:tool-cache": "cargo test --release --locked --manifest-path src-tauri/Cargo.toml engine::native::tools::fs::tests::benchmark_duplicate_search_coalescence -- --ignored --nocapture --test-threads=1",
    "measure:tool-output": "cargo test --release --locked --manifest-path src-tauri/Cargo.toml engine::native::output_compaction::tests::benchmark_provider_output_reduction -- --ignored --nocapture --test-threads=1",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "dompurify": "3.4.13",
    "marked": "18.0.9",
    "solid-js": "1.9.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.10"
  }
}
