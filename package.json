{
  "name": "codex-desktop-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.22.0"
  },
  "scripts": {
    "dev": "pnpm tools:bootstrap && pwsh -File scripts\\dev-check.ps1",
    "dev:server": "vite",
    "dev:check": "pwsh -File scripts\\dev-check.ps1 -CheckOnly",
    "dev:launch": "pwsh -File scripts\\dev-start.ps1",
    "lint": "biome check src vite.config.ts vitest.config.ts",
    "lint:fix": "biome check --write src vite.config.ts vitest.config.ts",
    "test:frontend": "vitest run",
    "tools:bootstrap": "pwsh -NoProfile -File scripts\\bootstrap-tools.ps1",
    "tools:check": "pwsh -NoProfile -File scripts\\bootstrap-tools.ps1 -CheckOnly",
    "rg": "pwsh -NoProfile -File scripts\\run-ripgrep.ps1",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "build:desktop": "pnpm tools:bootstrap && pnpm build",
    "release:check": "pwsh -File scripts\\release-check.ps1 -CheckOnly",
    "release:build": "pwsh -File scripts\\release-check.ps1 -SkipLaunch",
    "release": "pwsh -File scripts\\release-check.ps1",
    "smoke:browser": "pnpm tools:bootstrap && cargo run --locked --manifest-path src-tauri/Cargo.toml -- --browser-smoke",
    "check": "pnpm build:desktop && cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "clippy": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test": "cargo test --locked --manifest-path src-tauri/Cargo.toml --all-targets",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "verify:benchmarks": "pnpm tools:bootstrap && pnpm measure:streaming && pnpm measure:soak && pnpm measure:diff && pnpm measure:syntax && pnpm measure:code-mode-warmup && pnpm measure:command-stream && pnpm measure:background-command && pnpm measure:parallel-commands",
    "verify:encoding": "node scripts/verify-text-encoding.mjs",
    "verify:frontend": "pnpm verify:encoding && pnpm lint && pnpm test:frontend && pnpm verify:benchmarks && pnpm verify:visual",
    "verify:visual": "pnpm build && node --experimental-strip-types scripts/verify-visual-preview.mjs",
    "verify:native": "pnpm tools:bootstrap && pnpm verify:transitive && cargo check --locked --manifest-path src-tauri/Cargo.toml && pnpm format:check && pnpm clippy && pnpm test",
    "verify": "pnpm verify:frontend && pnpm verify:native",
    "verify:transitive": "node scripts/verify-transitive-dependencies.mjs",
    "verify:version": "node scripts/verify-version.mjs",
    "measure:release": "pwsh -File scripts/measure-release.ps1",
    "measure:command-output": "cargo test --release --locked --manifest-path src-tauri/Cargo.toml engine::native::output_compaction::tests::benchmark_semantic_command_output_reduction -- --ignored --nocapture --test-threads=1",
    "measure:code-mode-warmup": "cargo test --release --locked --manifest-path src-tauri/Cargo.toml engine::native::code_mode::tests::benchmark_code_mode_runtime_warmup -- --ignored --nocapture --test-threads=1",
    "measure:command-stream": "cargo test --release --locked --manifest-path src-tauri/Cargo.toml engine::native::terminal_output::stream::tests::benchmark_incremental_terminal_stream -- --ignored --nocapture --test-threads=1",
    "measure:background-command": "cargo test --release --locked --manifest-path src-tauri/Cargo.toml engine::native::tools::command_sessions::tests::benchmark_background_command_yield_and_incremental_polling -- --ignored --nocapture --test-threads=1",
    "measure:browser": "node --experimental-strip-types scripts/compare-browser-metrics.ts",
    "measure:diff": "node --import ./scripts/register-typescript-imports.mjs --experimental-strip-types scripts/measure-diff.ts",
    "measure:history": "node --import ./scripts/register-typescript-imports.mjs --expose-gc --max-old-space-size=4096 --experimental-strip-types scripts/measure-history.ts",
    "measure:output-search": "cargo test --release --locked --manifest-path src-tauri/Cargo.toml engine::native::storage::output_search::tests::benchmark_targeted_output_search -- --ignored --nocapture --test-threads=1",
    "measure:parallel-commands": "node --experimental-strip-types scripts/measure-parallel-commands.ts",
    "measure:search": "cargo test --release --locked --manifest-path src-tauri/Cargo.toml engine::native::tools::fs::tests::benchmark_ripgrep_against_previous_scanner -- --ignored --nocapture --test-threads=1",
    "measure:soak": "node --import ./scripts/register-typescript-imports.mjs --experimental-strip-types scripts/measure-soak.ts",
    "measure:streaming": "node --experimental-strip-types scripts/measure-streaming.ts",
    "measure:syntax": "node --import ./scripts/register-typescript-imports.mjs --experimental-strip-types scripts/measure-syntax.ts",
    "measure:tool-cache": "cargo test --release --locked --manifest-path src-tauri/Cargo.toml engine::native::tools::fs::tests::benchmark_duplicate_search_coalescence -- --ignored --nocapture --test-threads=1",
    "measure:tool-catalog": "cargo test --release --locked --manifest-path src-tauri/Cargo.toml engine::native::tools::tests::benchmark_tool_catalog_token_budget -- --ignored --nocapture --test-threads=1",
    "measure:tool-output": "cargo test --release --locked --manifest-path src-tauri/Cargo.toml engine::native::output_compaction::tests::benchmark_provider_output_reduction -- --ignored --nocapture --test-threads=1",
    "measure:tokens": "pnpm measure:tool-catalog && pnpm measure:tool-output && pnpm measure:command-output && pnpm measure:history && pnpm measure:output-search && pnpm measure:tool-cache",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "dompurify": "3.4.14",
    "marked": "18.0.11",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.11"
  }
}
