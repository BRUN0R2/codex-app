{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Codex App",
  "version": "0.0.3-alpha.1",
  "identifier": "dev.codexapp.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 640,
        "decorations": false,
        "center": true,
        "backgroundColor": "#111111"
      },
      {
        "label": "notification-priority-overlay",
        "url": "index.html?surface=notification-overlay&channel=priority",
        "title": "",
        "width": 460,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "shadow": false
      },
      {
        "label": "notification-transient-overlay",
        "url": "index.html?surface=notification-overlay&channel=transient",
        "title": "",
        "width": 390,
        "height": 140,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data: https:; style-src 'self'; font-src 'self' data:; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; img-src 'self' blob: data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/rg"],
    "targets": ["nsis"]
  }
}
